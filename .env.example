# Sao chép thành .env và điền giá trị thực

# === Tầng reasoning: coding-agent CLI headless (xem docs/F1.1) ===
AGENT_BACKEND=codex            # codex | none(=rule-only). Cline (máy công ty) cắm sau.
CODEX_MODEL=                   # bỏ trống = mặc định của codex
CODEX_SANDBOX=workspace-write  # read-only | workspace-write | danger-full-access
CODEX_TIMEOUT_SEC=180
# CODEX_CD=                    # thư mục làm việc (mặc định = repo root)
# CODEX_BIN=codex              # đường dẫn binary nếu khác

# === [DEPRECATED] llama.cpp VLM — KHÔNG còn dùng (đã chuyển sang Codex CLI) ===
# LLM_BASE_URL=http://localhost:8080
# LLM_MODEL=gemma-4
# LLM_API_KEY=none
# LLM_TIMEOUT_SEC=120

# === OCR remote (tùy chọn — paddle chạy ở máy khác qua ocr_service/) ===
# Set OCR_BASE_URL → app gọi OCR qua HTTP, KHÔNG cần cài paddle trên máy app.
# Bỏ trống → dùng OCR local (paddle/tesseract nếu cài), không có thì bỏ qua text.
# OCR_BASE_URL=http://localhost:8081
OCR_TIMEOUT_SEC=60

# === Tùy chọn ===
MAX_IMAGE_SIZE_MB=10           # giới hạn kích thước ảnh upload

# === Gỡ lỗi (xem SETUP.md mục 7) ===
# DEBUG_ERRORS=1               # mặc định 1 (dev) — trả {stage,type,message,traceback} trong response
                               # Đặt 0 khi lên production để giấu traceback; console vẫn log
LOG_LEVEL=DEBUG                # DEBUG | INFO | WARNING — mức log ra console server (mặc định DEBUG)
LOG_FILE=logs/ui_defect.log    # đường dẫn file log (RotatingFileHandler, 10MB x 3 bản)
