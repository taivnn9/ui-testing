# Sao chép thành .env và điền giá trị thực

# === llama.cpp endpoint (bắt buộc nếu dùng VLM agents) ===
LLM_BASE_URL=http://localhost:8080     # URL server llama.cpp (có thể ở máy khác)
LLM_MODEL=gemma-4                      # tên model đang serve
LLM_API_KEY=none                       # api key nếu server yêu cầu, không thì để "none"
LLM_TIMEOUT_SEC=120                    # timeout HTTP (giây)

# === OCR remote (tùy chọn — paddle chạy ở máy khác qua ocr_service/) ===
# Set OCR_BASE_URL → app gọi OCR qua HTTP, KHÔNG cần cài paddle trên máy app.
# Bỏ trống → dùng OCR local (paddle/tesseract nếu cài), không có thì bỏ qua text.
# OCR_BASE_URL=http://localhost:8081
OCR_TIMEOUT_SEC=60

# === Tùy chọn ===
MAX_IMAGE_SIZE_MB=10           # giới hạn kích thước ảnh upload

# === Gỡ lỗi (xem SETUP.md mục 7) ===
DEBUG_ERRORS=1                 # 1 = trả {stage,type,message,traceback} trong response (dev)
                               # 0 = giấu traceback khỏi response (production); console vẫn log
LOG_LEVEL=INFO                 # INFO | DEBUG | WARNING — mức log ra console server
