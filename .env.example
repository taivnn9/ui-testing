# Sao chép thành .env và điền giá trị thực

# === llama.cpp endpoint (bắt buộc nếu dùng VLM agents) ===
LLM_BASE_URL=http://localhost:8080     # URL server llama.cpp của công ty
LLM_MODEL=gemma-4                      # tên model đang serve
LLM_API_KEY=none                       # api key nếu server yêu cầu, không thì để "none"
LLM_TIMEOUT_SEC=120                    # timeout HTTP (giây)

# === Tùy chọn ===
MAX_IMAGE_SIZE_MB=10
DEBUG=false
